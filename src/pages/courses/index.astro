---
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog.css';

interface Course {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
}

const courseFiles = import.meta.glob<{ frontmatter: Course }>('./**/*.md', { eager: true });

const sorted: (Course & { url: string })[] = Object.entries(courseFiles)
    .map(([path, mod]) => ({
        ...mod.frontmatter,
        url: `${import.meta.env.BASE_URL}courses/` + path.replace('./', '').replace('.md', '') + '/',
    }))
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const allTags = [...new Set(sorted.flatMap(course => course.tags ?? []))].sort();

function formatDate(dateStr: string) {
    const match = dateStr.match(/^(\d{4})-(\d{2})-(\d{2})/);

    const date = match
        ? new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]))
        : new Date(dateStr);

    return date.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
    });
}
---

<Layout pageTitle="Courses">
    <div class="page-container">
        <h1>Courses</h1>

        <p class="intro-text">
            The course registration system for the University of Manitoba has very limited course descriptions
            available. Below is a list of courses that I teach and with a detailed description of the course content and
            and some of the assignments.  
        </p>

        <div class="blog-tag-filters">
            <button class="blog-tag-btn active" data-tag="all">All</button>
            {allTags.map(tag => (
                <button class="blog-tag-btn" data-tag={tag}>{tag}</button>
            ))}
        </div>

        <div class="blog-grid courses-grid" id="blog-grid">
            {sorted.map(course => (
                <a href={course.url} class="blog-card" data-tags={JSON.stringify(course.tags ?? [])}>
                    <div class="blog-card-inner">
                        <div>
                            <h2 class="blog-card-title">{course.title}</h2>
                            {course.description && (
                                <p class="blog-card-description">{course.description}</p>
                            )}
                            {course.tags && (
                                <div class="blog-card-tags">
                                    {course.tags.map((tag: string) => (
                                        <span class="tag">{tag}</span>
                                    ))}
                                </div>
                            )}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
</Layout>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.blog-tag-btn');
    const cards = document.querySelectorAll<HTMLElement>('.blog-card');

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            buttons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const selected = btn.dataset.tag!;
            cards.forEach(card => {
                const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
                card.style.display = (selected === 'all' || tags.includes(selected)) ? '' : 'none';
            });
        });
    });
</script>